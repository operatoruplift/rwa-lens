# --- Solana read plane (server only) -----------------------------------------
# Only 'devnet' or 'mainnet-beta'. Browser requests must match this cluster;
# they can never select an arbitrary RPC URL.
RWA_CLUSTER=mainnet-beta
# Required for live reads. Missing configuration produces an explicit unavailable state.
# A dedicated provider is strongly preferred; public endpoints rate-limit.
RWA_RPC_URL=
RWA_RPC_TIMEOUT_MS=8000
RWA_RPC_MAX_ACCOUNTS=100
RWA_INSPECT_CACHE_SECONDS=15
# Offline fixtures are opt-in, only with RWA_CLUSTER=devnet, and never on Vercel production.
RWA_FIXTURES_ENABLED=false

# --- Optional issuer registry (disabled unless configured) -------------------
RWA_REGISTRY_URL=
RWA_REGISTRY_ALLOWED_HOSTS=
# Comma-separated https hosts a token metadata URI may be fetched from.
# Empty means deny-by-default: no metadata URI is ever fetched.
RWA_METADATA_ALLOWED_HOSTS=

# --- Optional saved reports --------------------------------------------------
# Leave false to keep the app fully usable with local JSON/CSV export only.
RWA_REPORTS_ENABLED=false
# Wallet sign-in needs all durable configuration below. Minimum 32 characters; generate with
# `head -c 48 /dev/urandom | base64`. Unset means sign-in is disabled and the
# app stays fully usable as a guest. Never commit a real value.
RWA_SESSION_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy name retained for documentation; unused by the reports repository.
SUPABASE_SECRET_KEY=
# Shared rate limiter. Matches private.rate_limit_config.secret in the database
# (created by the create_rate_limiter migration). Unset = per-instance window.
RATE_LIMIT_SECRET=

# --- Durable wallet sign-in / private reports (server only) ------------------
# Required TOGETHER before optional sign-in/save is exposed. Dedicated RWA DB
# only. Generic NEXT_PUBLIC_* / SUPABASE_SECRET_KEY values do not enable reports.
# Apply supabase/migrations/202609200001_rwa_wallet_reports.sql, then verify it.
# Exact HTTPS origin, no trailing slash. localhost HTTP is development-only.
RWA_APP_ORIGIN=
RWA_SUPABASE_URL=
RWA_SUPABASE_SERVICE_ROLE_KEY=
# The existing NEXT_PUBLIC_SUPABASE_URL/PUBLISHABLE_KEY + RATE_LIMIT_SECRET are
# retained ONLY for the legacy shared read limiter in the independent RWA DB.
# RWA_* database credentials select the new service-role-only shared limiter.
# Sign-in and report writes fail closed when shared storage is unavailable.
